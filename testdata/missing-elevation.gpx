<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="summit-test"
     xmlns="http://www.topografix.com/GPX/1/1">
  <!-- Points 2 and 5 have no <ele>. Only the 150 -> 160 pair is a
       continuous edge, so gain is 10 m and loss is 0 m. Treating the gaps as
       zero elevation would report 160 m gain and 150 m loss. -->
  <trk>
    <name>Missing Elevation</name>
    <trkseg>
      <trkpt lat="45.0000" lon="6.0000">
        <ele>100.0</ele>
        <time>2024-06-01T08:00:00Z</time>
      </trkpt>
      <trkpt lat="45.0100" lon="6.0000">
        <time>2024-06-01T08:00:10Z</time>
      </trkpt>
      <trkpt lat="45.0200" lon="6.0000">
        <ele>150.0</ele>
        <time>2024-06-01T08:00:20Z</time>
      </trkpt>
      <trkpt lat="45.0300" lon="6.0000">
        <ele>160.0</ele>
        <time>2024-06-01T08:00:30Z</time>
      </trkpt>
      <trkpt lat="45.0400" lon="6.0000">
        <time>2024-06-01T08:00:40Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
