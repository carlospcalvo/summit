    <name>First Track</name>
    <trkseg>
      <trkpt lat="45.0000" lon="6.0000">
        <ele>100.0</ele>
        <time>2024-06-01T08:00:00Z</time>
      </trkpt>
      <trkpt lat="45.0100" lon="6.0000">
        <ele>130.0</ele>
        <time>2024-06-01T08:00:10Z</time>
      </trkpt>
    </trkseg>
  </trk>
  <trk>
    <name>Second Track</name>
    <trkseg>
      <trkpt lat="48.8566" lon="2.3522">
        <ele>35.0</ele>
        <time>2024-06-02T08:00:00Z</time>
      </trkpt>
      <trkpt lat="45.7640" lon="4.8357">
        <ele>160.0</ele>
        <time>2024-06-02T10:00:00Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
