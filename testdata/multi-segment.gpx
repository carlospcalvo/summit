<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="summit-test"
     xmlns="http://www.topografix.com/GPX/1/1">
  <!-- Segment 0 ends at 45.01/6.00 and segment 1 begins 200 km away at
       46.50/8.00. Distance must never bridge that gap. -->
  <trk>
    <name>Multi Segment</name>
    <trkseg>
      <trkpt lat="45.0000" lon="6.0000">
        <ele>500.0</ele>
        <time>2024-06-01T08:00:00Z</time>
      </trkpt>
      <trkpt lat="45.0100" lon="6.0000">
        <ele>520.0</ele>
        <time>2024-06-01T08:01:00Z</time>
      </trkpt>
    </trkseg>
    <trkseg>
      <trkpt lat="46.5000" lon="8.0000">
        <ele>900.0</ele>
        <time>2024-06-01T12:00:00Z</time>
      </trkpt>
      <trkpt lat="46.5100" lon="8.0000">
        <ele>940.0</ele>
        <time>2024-06-01T12:01:00Z</time>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
